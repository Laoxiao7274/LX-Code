{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LXCode",
  "version": "0.2.0",
  "identifier": "com.lxcode.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @lxcode/desktop dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @lxcode/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LXCode",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#111312"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": ["resources/pi-host", "resources/node", "resources/git"]
  },
  "plugins": {
    "shell": {
      "open": "https?://\\S+"
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MTJENkU2OTFCQ0NCNzgKUldSNHk3eVI1dFlTWkd2YWJFNlFRQzFhNEFnN3dzS0lydjBhdjMrdDhFVy8zZWtRdmE1Mzh3ZTEK",
      "endpoints": [
        "https://github.com/Laoxiao7274/LX-Code/releases/latest/download/latest.json"
      ]
    }
  }
}
