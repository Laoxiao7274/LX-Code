+/**
+ * Type-only shim for pi-mcp-adapter.
+ *
+ * pi-mcp-adapter publishes uncompiled .ts sources (package.json "exports" →
+ * ./index.ts). LXCode's strict tsc would type-check those sources and fail
+ * (TS2835 NodeNext extension rules, TS7006 implicit-any under strict mode).
+ * To avoid that, this shim provides types for the only API LXCode imports
+ * (createMcpAdapter); tsc resolves "types" / "exports"."."."types" → this
+ * file and skips it via skipLibCheck. Runtime still loads the real
+ * ./index.ts via "exports"."."."import" (tsx resolves .ts sources), so the
+ * actual adapter implementation runs unchanged.
+ *
+ * If pi-mcp-adapter's createMcpAdapter signature changes, update this shim.
+ */
+export interface McpAdapterOptions {
+  /** Path to the MCP config file (pi-global override). */
+  configPath?: string;
+}
+
+export declare function createMcpAdapter(options?: McpAdapterOptions): (pi: any) => void;
+
+export default createMcpAdapter;
